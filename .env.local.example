# Kopieer naar .env.local en vul de waarden in
# Gebruik: npm run test:local -- dispatcher
# Gebruik: npm run test:local -- verifier

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Azure Service Bus ---
SB_NAMESPACE=your-namespace
SB_QUEUE=your-queue-name
SB_KEY_NAME=your-policy-name
SB_KEY_VALUE=your-sas-key

# --- Business Central ---
BC_TENANT_ID=your-tenant-uuid
BC_CLIENT_ID=your-client-uuid
BC_CLIENT_SECRET=your-client-secret
BC_ENVIRONMENT=Sandbox_POC_20251229
BC_COMPANY_ID=your-company-uuid
