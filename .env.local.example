# Kopieer naar .env.local en vul de waarden in.
# Gebruik: npm run test:local -- <mode>   (zie README / scripts/test-local.ts)
#
# Dubbele config-set + APP_TARGET (fase 201)
# -------------------------------------------
# Een Docker-image draagt BEIDE Lambda-functies (dispatcher EN verifier);
# HANDLER selecteert welke draait. Beide functies dragen BEIDE config-sets:
# SANDBOX_* en PROD_*. APP_TARGET schakelt over twee assen tegelijk -- de
# BC-API-as (BC_ENVIRONMENT, BC_COMPANY_ID) en de Service Bus-as (SB_*).
#
#   APP_TARGET=sandbox       -> leest de SANDBOX_*-set   (DEFAULT, geen flip)
#   APP_TARGET=production    -> leest de PROD_*-set       (pas vanaf fase 202)
#   APP_TARGET leeg/ongezet  -> legacy ongeprefixt pad    (losse keys onderaan)
#
# De flip naar production gebeurt PAS in fase 202 (verifier eerst). De default
# blijft sandbox. Echte secrets komen uit AWS Secrets Manager / de runtime-env
# en worden NOOIT gecommit -- dit bestand bevat alleen placeholders.

# --- APP_TARGET (default: sandbox; geen flip) ---
APP_TARGET=sandbox

# --- Gedeelde keys (omgeving-onafhankelijk, ALTIJD ongeprefixt) ---
BC_TENANT_ID=your-tenant-uuid
BC_CLIENT_ID=your-client-uuid
BC_CLIENT_SECRET=your-client-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# SANDBOX config-set (APP_TARGET=sandbox)  -- dispatcher EN verifier
# ============================================================================
# BC-as
SANDBOX_BC_ENVIRONMENT=Sandbox_POC_20251229
SANDBOX_BC_COMPANY_ID=your-sandbox-company-uuid
# Service Bus-as
SANDBOX_SB_NAMESPACE=your-sandbox-namespace
SANDBOX_SB_QUEUE=bratra-inbound
SANDBOX_SB_KEY_NAME=your-sandbox-policy-name
SANDBOX_SB_KEY_VALUE=your-sandbox-sas-key
# Error-queue (optioneel; valt terug op SANDBOX_SB_KEY_* als niet gezet)
SANDBOX_SB_ERROR_QUEUE=bratra-error
SANDBOX_SB_ERROR_KEY_NAME=your-sandbox-error-policy-name
SANDBOX_SB_ERROR_KEY_VALUE=your-sandbox-error-sas-key

# ============================================================================
# PRODUCTION config-set (APP_TARGET=production)  -- dispatcher EN verifier
# PAS gebruiken vanaf fase 202 (verifier eerst). NU niet de default flippen.
# ============================================================================
# BC-as
PROD_BC_ENVIRONMENT=Production
PROD_BC_COMPANY_ID=your-prod-company-uuid
# Service Bus-as
PROD_SB_NAMESPACE=your-prod-namespace
PROD_SB_QUEUE=bratra-inbound
PROD_SB_KEY_NAME=your-prod-policy-name
PROD_SB_KEY_VALUE=your-prod-sas-key
# Error-queue (optioneel; valt terug op PROD_SB_KEY_* als niet gezet)
PROD_SB_ERROR_QUEUE=bratra-error
PROD_SB_ERROR_KEY_NAME=your-prod-error-policy-name
PROD_SB_ERROR_KEY_VALUE=your-prod-error-sas-key

# ============================================================================
# Legacy ongeprefixte keys (APP_TARGET leeg/ongezet -> legacy-pad)
# ============================================================================
# Zolang APP_TARGET niet gezet is, leest de resolver deze ongeprefixte targeted
# keys. Met APP_TARGET=sandbox/production worden ze genegeerd voor de targeted
# keys. Backward-compat -- standaard uitgecommentarieerd zodat de SANDBOX_*-set
# leidend is.
# BC_ENVIRONMENT=Sandbox_POC_20251229
# BC_COMPANY_ID=your-company-uuid
# SB_NAMESPACE=your-namespace
# SB_QUEUE=your-queue-name
# SB_KEY_NAME=your-policy-name
# SB_KEY_VALUE=your-sas-key
